# Discord: create an app at https://discord.com/developers/applications, add a Bot, copy its token.
DISCORD_TOKEN=
# While developing, set your server id so slash commands appear instantly (global sync can take an hour).
DEV_GUILD_ID=

# Financial Modeling Prep (https://financialmodelingprep.com). The same key lineage uses.
FMP_API_KEY=

# sqlite for dev / one-machine deployments; postgres for anything shared:
#   postgresql+asyncpg://user:pass@host:5432/versus   (pip install -e ".[postgres]")
DATABASE_URL=sqlite+aiosqlite:///./versus.db

# Engine cadence (seconds)
POLL_INTERVAL_S=5
FILL_DELAY_S=1
FILL_TIMEOUT_S=30
BOARD_REFRESH_S=60
# Players needed before /party start works. Use 1 to test a round by yourself.
MIN_PLAYERS=2
# DEV ONLY: treat the market as always open so /buy, /sell, the board and settlement can be tested after hours.
DEV_MARKET_ALWAYS_OPEN=false
LOG_LEVEL=INFO

# /ask copilot. Get a key at https://console.anthropic.com. Leave empty to disable /ask.
ANTHROPIC_API_KEY=
ASK_MODEL=claude-opus-5
ASK_EFFORT=medium
ASK_RATE_PER_HOUR=20
